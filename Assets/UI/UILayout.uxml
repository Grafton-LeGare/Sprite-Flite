    <ui:Label text="Score: 0" name="ScoreLabel" style="top: 0; left: 57px; color: rgb(221, 221, 221); font-size: 36px; -unity-text-align: lower-center; -unity-text-outline-width: 0; letter-spacing: 1px; word-spacing: 3px; -unity-font-style: bold; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(255, 251, 0); border-right-color: rgb(255, 251, 0); border-top-color: rgb(255, 251, 0); border-bottom-color: rgb(255, 251, 0); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; width: 265px; height: 48px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Play-Regular.ttf?fileID=12800000&amp;guid=3df18074f239143779ae89a552fbe55d&amp;type=3#Play-Regular&quot;);"/>
    <ui:Label text="High Score: 100" name="HighScoreLabel" style="position: absolute; top: 40%; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Play-Bold.ttf?fileID=12800000&amp;guid=d6b3e4619cd394654a54bbce5a7af4e4&amp;type=3#Play-Bold&quot;); font-size: 48px; align-self: center; translate: 0 0%; color: rgb(243, 243, 243); background-color: rgb(48, 53, 40); width: 460px; -unity-text-align: middle-center; height: 115px; align-content: auto; justify-content: flex-start; align-items: auto; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; -unity-font-style: normal; border-top-width: 1px; border-right-width: 0; border-bottom-width: 1px; border-left-width: 0; border-left-color: rgb(148, 148, 148); border-right-color: rgb(148, 148, 148); border-top-color: rgb(148, 148, 148); border-bottom-color: rgb(148, 148, 148); -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 0.506); display: none; transform-origin: center;"/>
    <ui:Button text="Restart" name="RestartButton" focusable="false" style="width: 290px; height: 91px; align-self: center; position: absolute; top: 64%; font-size: 41px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Play-Regular.ttf?fileID=12800000&amp;guid=3df18074f239143779ae89a552fbe55d&amp;type=3#Play-Regular&quot;); background-color: rgba(46, 46, 46, 0.871); -unity-background-image-tint-color: rgb(255, 255, 255); visibility: visible; display: none; opacity: 1; color: rgb(243, 243, 243); border-top-left-radius: 47px; border-top-right-radius: 47px; border-bottom-right-radius: 47px; border-bottom-left-radius: 47px; justify-content: flex-start; align-content: center; align-items: auto; transform-origin: center; translate: 0 -100%;"/>
